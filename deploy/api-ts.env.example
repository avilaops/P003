# Server-local configuration • use the same restricted application role as Rust.
# Copy to the private release directory as api-ts.env with mode 0600.
# Do not add session, SMTP, fiscal, signing or migration/admin credentials.
DATABASE_URL=postgresql://erp_next_app:REPLACE_ON_SERVER@postgres.internal.example:5432/erp?sslmode=verify-full
DATABASE_MAX_CONNECTIONS=5
AUTH_ISSUER=https://auth.avilaops.com
AUTH_USERINFO_URL=https://auth.avilaops.com/oauth/userinfo
ERP_MCP_ORIGIN=https://erp.avilaops.com
