{
  "name": "api-ts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "files": ["dist", "assets", "README.md"],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/server.ts",
    "start": "node dist/server.js",
    "migrate": "node dist/migrate.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "openapi": "tsx scripts/openapi.ts",
    "openapi:check": "tsx scripts/openapi.ts --check",
    "route-coverage": "tsx scripts/route-coverage.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "browser-use-sdk": "3.12.1",
    "fastify": "^5.6.2",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.6",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
