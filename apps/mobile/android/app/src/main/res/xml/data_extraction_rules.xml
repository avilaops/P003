<?xml version="1.0" encoding="utf-8"?>
<!-- Sessão e tokens nunca vão para backup nem para outro aparelho. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
